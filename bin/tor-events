#!/usr/bin/env bash
# bin/tor-events — dengar Tor ControlPort, emit event realtime ke state/events.jsonl.
# client-only: tidak butuh server, semua localhost.
# usage: tor-events start|stop|status|_run
# env: TOR_CONTROL_HOST, TOR_CONTROL_PORT, TOR_COOKIE_FILE, TORSTACK_ROOT
set -u
_src="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  _rl="$(readlink -f "$_src" 2>/dev/null || true)"
  [ -n "${_rl:-}" ] && _src="$_rl"
fi
ROOT="${TORSTACK_ROOT:-$(cd "$(dirname "$_src")/.." && pwd)}"
if [ -f "$ROOT/lib/shim.sh" ]; then . "$ROOT/lib/shim.sh" 2>/dev/null || true; fi
: "${TORSTACK_BASH:=bash}"
PID_FILE="$ROOT/state/tor-events.pid"
LOG="$ROOT/logs/tor-events.log"
EVENTS="$ROOT/state/events.jsonl"
HOST="${TOR_CONTROL_HOST:-127.0.0.1}"
PORT="${TOR_CONTROL_PORT:-9051}"
COOKIE="${TOR_COOKIE_FILE:-$ROOT/state/tor-data/control_auth_cookie}"

alive() { [ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null; }

cmd_start() {
  mkdir -p "$ROOT/state" "$ROOT/logs"
  if alive "$PID_FILE"; then echo "tor-events already running pid=$(cat "$PID_FILE")"; exit 0; fi
  nohup "$TORSTACK_BASH" "$_src" _run >>"$LOG" 2>&1 &
  echo $! > "$PID_FILE"
  echo "tor-events started pid=$! (${HOST}:${PORT})"
}

cmd_stop() {
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
  pkill -f "tor-events _run" 2>/dev/null || true
  echo "tor-events stopped."
}

cmd_status() {
  if alive "$PID_FILE"; then echo "tor-events: RUN pid=$(cat "$PID_FILE")";
  else echo "tor-events: STOP"; fi
  echo -n "events lines: "; wc -l <"$EVENTS" 2>/dev/null || echo 0
}

# _run: loop listener (auto-reconnect 5s). Protokol di lib/torctl.py;
# torctl jalan SATU sesi lalu exit (0=aneh, 1=putus) — bash yang mengulang.
# Jangan dipanggil manual.
cmd_run() {
  mkdir -p "$ROOT/state" "$ROOT/logs"
  TORCTL="$ROOT/lib/torctl.py"
  if [ ! -f "$TORCTL" ]; then
    echo "[tor-events] hilang: $TORCTL (re-install / update tree)" >&2
    exit 1
  fi
  # emit start langsung via bash (torctl emit detail sesi sendiri)
  printf '{"ts":%s,"type":"tor-events.start","source":"tor-events","data":{}}\n' \
    "$(date +%s)000" >>"$EVENTS" 2>/dev/null || true
  while true; do
    python3 "$TORCTL" listen --host "$HOST" --port "$PORT" \
      --cookie "$COOKIE" --out "$EVENTS" --source tor-events >>"$LOG" 2>&1 || true
    sleep 5
  done
}

case "${1:-status}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  _run) cmd_run ;;
  *) echo "usage: tor-events {start|stop|status}"; exit 1 ;;
esac
