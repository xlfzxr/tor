#!/usr/bin/env bash
# tor-rotate — kirim SIGNAL NEWNYM ke ControlPort 9051 (cookie auth).
# Protokol control-port milik lib/torctl.py; file ini hanya orkestrasi
# bash (ip lama/baru, stamp, emit event).
set -euo pipefail
_src="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  _rl="$(readlink -f "$_src" 2>/dev/null || true)"
  [ -n "${_rl:-}" ] && _src="$_rl"
fi
ROOT="${TORSTACK_ROOT:-$(cd "$(dirname "$_src")/.." && pwd)}"
HOST="${TOR_CONTROL_HOST:-127.0.0.1}"
PORT="${TOR_CONTROL_PORT:-9051}"
COOKIE="${TOR_COOKIE_FILE:-$ROOT/state/tor-data/control_auth_cookie}"
STAMP="$ROOT/state/last-rotate"
WAIT="${ROTATE_WAIT:-3}"

# event bus (best effort)
if [ -f "$ROOT/lib/events.sh" ]; then . "$ROOT/lib/events.sh" 2>/dev/null || true; fi
command -v emit >/dev/null 2>&1 || emit() { :; }

if [ ! -f "$COOKIE" ]; then
  echo "[rotate] cookie tidak ada: $COOKIE (apakah tor jalan? cek logs/tor.log)" >&2
  emit rotate.fail '{"reason":"no-cookie"}' tor-rotate
  exit 1
fi

OLD_IP_NOW="$(curl -s --max-time 10 --socks5-hostname 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || true)"
emit rotate.pre "{\"old\":\"${OLD_IP_NOW:-?}\"}" tor-rotate

TORCTL="$ROOT/lib/torctl.py"
if [ ! -f "$TORCTL" ]; then
  echo "[rotate] hilang: $TORCTL (re-install / update tree)" >&2
  emit rotate.fail '{"reason":"no-torctl"}' tor-rotate
  exit 1
fi
if python3 "$TORCTL" newnym --host "$HOST" --port "$PORT" --cookie "$COOKIE"
then
  : # lanjut ke emit ok di bawah
else
  rc=$?
  emit rotate.fail '{"reason":"newnym-failed"}' tor-rotate
  exit $rc
fi

date +%s > "$STAMP"
echo "[rotate] NEWNYM ok @ $(cat "$STAMP"), tunggu ${WAIT}s..."
sleep "$WAIT"
# tampilkan IP baru (best effort)
NEW_IP_NOW="$(curl -s --max-time 10 --socks5-hostname 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || true)"; echo "${NEW_IP_NOW:-}"
if [ -n "${NEW_IP_NOW:-}" ]; then
  emit net.ip_changed "{\"ip\":\"$NEW_IP_NOW\",\"old\":\"${OLD_IP_NOW:-}\",\"via\":\"rotate\"}" tor-rotate
fi
emit rotate.ok "{\"old\":\"${OLD_IP_NOW:-}\",\"new\":\"${NEW_IP_NOW:-}\"}" tor-rotate
