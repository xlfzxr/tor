# profiles/crawl.env — SOCKS5 langsung 9050, rotate agresif
# usage: set -a; . ~/torstack/profiles/crawl.env; set +a
# crawl pakai SOCKS langsung (tanpa privoxy) agar gampang rotate + per-request proxy
unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy || true
export TOR_SOCKS="127.0.0.1:9050"
export TOR_HTTP_PROXY="http://127.0.0.1:8118"
export CRAWL_SOCKS="socks5h://127.0.0.1:9050"
export CRAWL_ROTATE_EVERY="${CRAWL_ROTATE_EVERY:-20}"
export CRAWL_DELAY_MS="${CRAWL_DELAY_MS:-1500}"
export ROTATE_WAIT="5"
export CURL_TIMEOUT="30"
export HEALTH_TIMEOUT="15"
export MAX_RETRY="3"
export ALLOW_DIRECT="0"
