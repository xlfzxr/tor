# profiles/opencode.env — dipakai opencode CLI / agent (HTTP_PROXY 8118, timeout long)
# usage: set -a; . ~/torstack/profiles/opencode.env; set +a
export HTTP_PROXY="http://127.0.0.1:8118"
export HTTPS_PROXY="http://127.0.0.1:8118"
export http_proxy="http://127.0.0.1:8118"
export https_proxy="http://127.0.0.1:8118"
export ALL_PROXY="socks5h://127.0.0.1:9050"
export all_proxy="socks5h://127.0.0.1:9050"
export NO_PROXY="localhost,127.0.0.1,::1"
export no_proxy="localhost,127.0.0.1,::1"
# timeout long untuk model lambat via tor
export CURL_TIMEOUT="120"
export HEALTH_TIMEOUT="30"
export OPENCODE_TIMEOUT="180000"
export BUN_CONFIG_TIMEOUT="120000"
