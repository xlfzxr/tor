#!/usr/bin/env bash
# tools/biome — jalankan biome di Termux.
#
# Kenapa ada: package npm `@biomejs/biome` cuma punya prebuilt binary untuk
# win32/darwin/linux{,-musl}. Termux melaporkan process.platform = "android",
# jadi shim resmi tidak nemu binary dan keluar error. Tapi binary
# `@biomejs/cli-linux-arm64` (glibc) tetap jalan lewat loader glibc-repo.
#
# Cache binary: ~/.cache/torstack/bin/biome (di luar repo, tidak di-commit).
# Install manual:
#   npm pack @biomejs/cli-linux-arm64@$(node -p "require('./package.json').devDependencies['@biomejs/biome'].replace(/[^0-9.]/g,'')") --os=linux --cpu=arm64
#   tar -xzf biomejs-cli-linux-arm64-*.tgz
#   install -m755 package/biome ~/.cache/torstack/bin/biome
#
# Di Linux/CI, script ini transparan: pakai node_modules/.bin/biome.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE="${TORSTACK_BIOME_CACHE:-$HOME/.cache/torstack/bin/biome}"
GLIBC="${TORSTACK_GLIBC:-${PREFIX:-/data/data/com.termux/files/usr}/glibc}"
LOADER="$GLIBC/lib/ld-linux-aarch64.so.1"
LIBPATH="$GLIBC/lib:$GLIBC/usr/lib"

if [ "$(uname -s)" = "Darwin" ] || [ ! -d "$GLIBC" ]; then
  # bukan Termux: pakai binary bawaan package manager
  exec "$ROOT/node_modules/.bin/biome" "$@"
fi

if [ ! -x "$CACHE" ]; then
  echo "[tools/biome] binary belum ada di $CACHE" >&2
  echo "[tools/biome] lihat instruksi install di header file ini." >&2
  exit 127
fi

if [ ! -e "$LOADER" ]; then
  echo "[tools/biome] glibc loader tidak ada: $LOADER" >&2
  echo "[tools/biome] jalankan: pkg install glibc-repo" >&2
  exit 127
fi

# env ini dibaca shim JS biome; dilewatkan agar `biome` dalam PATH tetap jalan
export BIOME_BINARY="$CACHE"
exec "$LOADER" --library-path "$LIBPATH" "$CACHE" "$@"
